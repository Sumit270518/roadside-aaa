{
  "name": "roadside-aaa",
  "version": "1.0.0",
  "description": "Roadside AAA - Roadside Vehicle Assistance & Mechanic Booking Platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "test:watch": "npm run test:watch --workspace=server",
    "seed": "npm run seed --workspace=server",
    "test:email": "npm run test:email --workspace=server --",
    "lint": "npm run lint --workspace=client --if-present",
    "install:all": "npm install --workspace=server && npm install --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "roadside-assistance",
    "mechanic-booking",
    "towing-service",
    "mern-stack",
    "leaflet",
    "socket.io"
  ],
  "author": "Roadside AAA Engineering Team",
  "license": "ISC"
}
