# Production Backend API URL (Your Render Web Service URL + /api/v1)
# Example: https://roadside-aaa-backend.onrender.com/api/v1
VITE_API_URL=https://your-backend-service.onrender.com/api/v1

# Production Socket.IO Host URL (Your Render Web Service Root URL)
# Example: https://roadside-aaa-backend.onrender.com
VITE_SOCKET_URL=https://your-backend-service.onrender.com
