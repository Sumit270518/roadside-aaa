# ==========================================
# ROADSIDE AAA - BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Port and Network Binding
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/roadside_aaa?retryWrites=true&w=majority

# JWT Authentication
# Use a high-entropy secret in production (minimum 32 characters)
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS & Socket.IO)
# Set to your production Vercel frontend URL (without trailing slash)
# Multiple origins can be comma-separated: https://your-app.vercel.app,http://localhost:5173
CLIENT_URL=https://your-frontend-app.vercel.app
CLIENT_ORIGIN=https://your-frontend-app.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Email Delivery (Gmail / SMTP)
# To send actual emails directly to users' Gmail inboxes on Login and Sign-Up:
# For Gmail: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
FROM_EMAIL="Roadside AAA Alerts" <your_gmail_address@gmail.com>

# Optional Custom SMTP (SendGrid, Mailgun, Brevo, SES, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Development Fallback (Set to true only for local offline development without MongoDB)
USE_IN_MEMORY_DB=false
